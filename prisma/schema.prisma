// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id         String   @id @default(uuid())
  firstname  String
  lastname   String
  nickname   String
  email      String   @unique
  password   String?
  address    String?
  city       String?
  postalCode String?  @map("postal_code")
  role       Role     @default(USER)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  orders     Order[]
  tickets    Ticket[]

  @@map("user")
}

enum EventType {
  MEET
  OTHER
}

model Event {
  id              String      @id @default(uuid())
  title           String
  description     String
  type            EventType   @default(MEET)
  published       Boolean     @default(false)
  opened          Boolean     @default(false)
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  eventActivities EventPart[]

  @@map("event")
}

enum EventPartType {
  BAR
  RESTAURANT
  ACTIVITY
  OTHER
}

model EventPart {
  id          String        @id @default(uuid())
  eventId     String        @map("event_id")
  title       String
  description String
  date        DateTime
  order       Int           @db.SmallInt
  type        EventPartType

  event Event @relation(fields: [eventId], references: [id])

  @@map("event_activity")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)
  category    String?
  imageUrl    String?
  virtual     Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  optionTypes OptionType[]
  skus        Sku[]

  @@map("product")
}

model OptionType {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product      Product       @relation(fields: [productId], references: [id])
  optionValues OptionValue[]

  @@map("option_type")
}

model OptionValue {
  id           String   @id @default(uuid())
  optionTypeId String   @map("option_type_id")
  value        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  optionType      OptionType       @relation(fields: [optionTypeId], references: [id])
  skuOptionValues SkuOptionValue[]

  @@map("option_value")
}

model Sku {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  skuCode       String   @unique @map("sku_code")
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)
  stock         Int      @default(0)
  trackStock    Boolean  @default(true) @map("track_stock")
  imageUrl      String?  @map("image_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product    Product          @relation(fields: [productId], references: [id])
  options    SkuOptionValue[]
  orderItems OrderItem[]

  @@map("sku")
}

model SkuOptionValue {
  skuId         String @map("sku_id")
  optionValueId String @map("option_value_id")

  sku         Sku         @relation(fields: [skuId], references: [id])
  optionValue OptionValue @relation(fields: [optionValueId], references: [id])

  @@id([skuId, optionValueId])
  @@map("sku_option_value")
}

enum OrderStatus {
  PAID
  PENDING
  FAILED
  CASH_PENDING
  CASH_PAID
}

model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  status          OrderStatus @default(PENDING)
  paymentIntentId String?     @unique @map("payment_intent_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]

  @@map("order")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  skuId     String  @map("sku_id")
  quantity  Int     @db.SmallInt
  unitPrice Decimal @db.Decimal(10, 2)

  order   Order @relation(fields: [orderId], references: [id])
  sku     Sku   @relation(fields: [skuId], references: [id])
  tickets Ticket[]

  @@map("order_item")
}

model Ticket {
  userId      String  @map("user_id")
  orderItemId String  @map("order_item_id")

  user      User      @relation(fields: [userId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@id(name: "pk_tickets", fields: [userId, orderItemId])
  @@map("ticket")
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  message     String
  active      Boolean
  actionLabel String?
  actionUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
