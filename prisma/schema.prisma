// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Furmeet {
  id          String   @id @default(uuid())
  title       String
  description String
  content     String
  date        DateTime
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Member {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  basePrice   Decimal  @db.Decimal(10, 2)
  category    String?
  imageUrl    String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  optionTypes OptionType[]
  skus        Sku[]

  @@map("product")
}

model OptionType {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product      Product       @relation(fields: [productId], references: [id])
  optionValues OptionValue[]

  @@map("option_type")
}

model OptionValue {
  id           String   @id @default(uuid())
  optionTypeId String   @map("option_type_id")
  value        String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  optionType      OptionType       @relation(fields: [optionTypeId], references: [id])
  skuOptionValues SkuOptionValue[]

  @@map("option_value")
}

model Sku {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  skuCode       String   @unique @map("sku_code")
  priceOverride Decimal? @map("price_override") @db.Decimal(10, 2)
  stock         Int      @default(0)
  imageUrl      String?  @map("image_url")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product Product          @relation(fields: [productId], references: [id])
  options SkuOptionValue[]

  @@map("sku")
}

model SkuOptionValue {
  skuId         String @map("sku_id")
  optionValueId String @map("option_value_id")

  sku         Sku         @relation(fields: [skuId], references: [id])
  optionValue OptionValue @relation(fields: [optionValueId], references: [id])

  @@id([skuId, optionValueId])
  @@map("sku_option_value")
}

model Announcement {
  id          String   @id @default(uuid())
  title       String
  message     String
  active      Boolean
  actionLabel String?
  actionUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
